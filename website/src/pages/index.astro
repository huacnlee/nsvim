---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Mock from "../components/Mock.astro";
import themes from "../data/themes.json";
import "../styles/site.css";

// The version is the app crate's. Astro builds from website/, so the crate is in ../nsh.
const cargo = readFileSync(resolve(process.cwd(), "../nsh/Cargo.toml"), "utf8");
const version = cargo.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? "0.0.0";
const repo = "https://github.com/huacnlee/nsvim";
const origin = "https://github.com/bjarneo/editor";
const install = `cargo install --locked --git ${repo} nsh-app-editor`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const dark = themes.filter((t) => !t.light).length;
const light = themes.length - dark;

const modes = [
  { id: "normal", label: "NORMAL", key: "Esc" },
  { id: "insert", label: "INSERT", key: "i" },
  { id: "visual", label: "VISUAL", key: "v" },
  { id: "command", label: "COMMAND", key: ":" },
];

const features = [
  ["Real Vim, or classic keys", "Counts, operators, text objects, dot repeat, registers, macros, marks and Visual block. Or no modes at all, with multiple cursors. Pick one at first launch and switch any time."],
  ["Code-aware", "Tree-sitter text objects (<code>af</code>, <code>ic</code>, <code>ia</code>) and motions (<code>]f</code>, <code>[c</code>) in 13 languages. LSP with diagnostics, go to definition, references, hover, completion, rename and code actions."],
  ["Find anything", "A fuzzy file finder, project search through ripgrep, a file tree with git status, and a list of every key with search: <kbd>F1</kbd>."],
  ["Native on each platform", "The UI is the platform's own views, through NSH: GTK 4 on Linux, AppKit on macOS, WinUI on Windows. Menus, text and scrolling behave as the system does."],
  ["Safe", "Crash recovery, undo that survives a restart, changed lines marked when a git checkout or an agent changes a file, and atomic saves."],
  ["Yours", `${themes.length} themes. On Omarchy, the System look follows the desktop theme live. Any monospace font. Settings is a tab that writes <code>config.toml</code>.`],
];

const keys = [
  ["Save", [":w"], ["Ctrl", "S"]],
  ["Go to file", ["SPC", "f"], ["Ctrl", "P"]],
  ["Find in project", ["SPC", "/"], ["Ctrl", "⇧", "F"]],
  ["Every key, with search", ["F1"], ["F1"]],
  ["Go to definition", ["gd"], ["F12"]],
  ["Rename symbol", ["SPC", "l", "n"], ["F2"]],
  ["Select a function", ["vaf"], []],
  ["Add a cursor at the next match", [], ["Ctrl", "D"]],
  ["Focus the file tree", ["SPC", "e"], ["Ctrl", "⇧", "E"]],
  ["Settings", [":Settings"], ["Ctrl", ","]],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>nsvim: Next Simple VIM</title>
    <meta
      name="description"
      content="nsvim is a modal code editor with Vim keys, drawn with the native views of each platform. Next Simple VIM, on Native Shell."
    />
    <meta name="theme-color" content="#0E1016" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content="nsvim: Next Simple VIM" />
    <meta property="og:description" content="A modal code editor with Vim keys, drawn with the native views of each platform." />
  </head>
  <body>
    <div class="mode-rule" aria-hidden="true"></div>

    <header class="strip">
      <div class="wrap">
        <a class="mark" href="#top" aria-label="nsvim, to the top">
          <svg viewBox="0 0 128 128" aria-hidden="true">
            <rect width="128" height="128" rx="28" fill="#151925"></rect>
            <path d="M33 30h17l45 60H78z" fill="#C39BFF"></path>
            <rect x="30" y="30" width="18" height="60" rx="5" fill="#6C9EFF"></rect>
            <rect x="80" y="30" width="18" height="60" rx="5" fill="#A7D46F"></rect>
            <rect x="30" y="98" width="68" height="8" rx="4" fill="#FFA266"></rect>
          </svg>
          nsvim
        </a>
        <dl class="meta">
          <div><dt>Rev</dt><dd>{version}</dd></div>
          <div><dt>UI</dt><dd>NSH, native views</dd></div>
          <div><dt>License</dt><dd>MIT</dd></div>
        </dl>
        <nav class="nav" aria-label="Sections">
          <a href="#features">Features</a>
          <a href="#keys">Keys</a>
          <a href="#agents">Agents</a>
          <a href="#themes">Themes</a>
          <a class="order-link" href="#install">Install</a>
          <a class="gh" href={repo}>GitHub</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="wrap lead" aria-labelledby="name">
        <div class="lead-copy">
          <h1 id="name">nsvim</h1>
          <p class="tagline">Next Simple VIM.<br />Native Shell VIM.</p>
          <p class="lede">A modal code editor with Vim keys, drawn with the native views of each platform.</p>
          <div class="actions">
            <a class="download" href="#install">
              <span class="download-label">Install nsvim {version}</span>
              <span class="download-file">With Cargo, from source</span>
            </a>
            <a class="all" href={repo}>Source on GitHub</a>
          </div>
        </div>

        <figure class="plate-1" aria-label="Plate 1, a model of the nsvim window in each of its modes">
          <div class="frame">
            <figcaption class="frame-title">Plate 1 · src/doc.rs · <b id="mode-name">NORMAL</b></figcaption>
            <div class="screen"><Mock /></div>
            <div class="modes" role="group" aria-label="Show a mode on Plate 1">
              {
                modes.map((m, i) => (
                  <button type="button" data-mode={m.id} aria-pressed={i === 0 ? "true" : "false"} style={`--c: var(--${m.id})`}>
                    <kbd>{m.key}</kbd>
                    {m.label}
                  </button>
                ))
              }
            </div>
          </div>
          <p class="plate-note">Press <kbd>i</kbd>, <kbd>v</kbd>, <kbd>:</kbd> or <kbd>Esc</kbd> on this page. Plate 1 changes mode, as nsvim does.</p>
          <p class="sr-only" aria-live="polite" id="mode-said"></p>
        </figure>

        <table class="keychars">
          <caption>Key characteristics</caption>
          <tbody>
            <tr>
              <td><span class="v">2<small>keymaps</small></span><span class="p">Neovim or classic, chosen at setup</span></td>
              <td><span class="v">3<small>platforms</small></span><span class="p">GTK 4, AppKit and WinUI views</span></td>
              <td><span class="v">13<small>languages</small></span><span class="p">with tree-sitter objects and motions</span></td>
              <td><span class="v">{themes.length}<small>themes</small></span><span class="p">built in, plus your Omarchy theme</span></td>
              <td><span class="v">0<small>AI inside</small></span><span class="p">your own agent drives it</span></td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="wrap sheet" id="features" aria-labelledby="features-h">
        <h2 id="features-h">Features</h2>
        <p class="intro">nsvim is for opening code, reading it, finding your way around it and making quick edits.</p>
        <ul class="features">
          {
            features.map(([title, text]) => (
              <li>
                <h3>{title}</h3>
                <p set:html={text} />
              </li>
            ))
          }
        </ul>

        <div class="blocks" aria-label="How nsvim works">
          <div class="block">
            <span class="t">UI thread</span>
            <ol class="chain">
              <li>Keys</li><li class="to" aria-hidden="true">→</li>
              <li>Keymap</li><li class="to" aria-hidden="true">→</li>
              <li>editor-core</li><li class="to" aria-hidden="true">→</li>
              <li>NSH views</li><li class="to" aria-hidden="true">→</li>
              <li>GTK 4, AppKit, WinUI</li>
            </ol>
            <p>One view takes every key. The keymap returns actions, and a view changes only when the part it shows changes.</p>
          </div>
          <div class="bus" aria-hidden="true"><span>jobs →</span><span>← events</span></div>
          <div class="block">
            <span class="t">Workers</span>
            <ul class="units">
              <li>Files</li><li>Project index</li><li>git</li><li>ripgrep</li><li>File watcher</li><li>LSP</li>
            </ul>
            <p>No file I/O, process or language server runs on the UI thread. A key never waits on the disk.</p>
          </div>
        </div>
      </section>

      <section class="wrap sheet" id="keys" aria-labelledby="keys-h">
        <h2 id="keys-h">Keys</h2>
        <p class="intro">Two keymaps, each complete. Setup asks which one you want, and can read your leader key from <code>~/.config/nvim</code>.</p>
        <div class="table-wrap">
          <table class="data keys">
            <thead>
              <tr><th scope="col">Action</th><th scope="col">Neovim keymap</th><th scope="col">Classic keymap</th></tr>
            </thead>
            <tbody>
              {
                keys.map(([action, vim, classic]) => (
                  <tr>
                    <th scope="row">{action}</th>
                    <td>{(vim as string[]).length ? (vim as string[]).map((k) => <kbd>{k}</kbd>) : "–"}</td>
                    <td>{(classic as string[]).length ? (classic as string[]).map((k) => <kbd>{k}</kbd>) : "–"}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="note">On macOS, <kbd>⌘</kbd> replaces <kbd>Ctrl</kbd> in the classic keymap. <a href={`${repo}/blob/main/docs/keymaps.md`}>docs/keymaps.md</a> has every key.</p>
      </section>

      <section class="wrap sheet" id="agents" aria-labelledby="agents-h">
        <h2 id="agents-h">Works with your agent</h2>
        <p class="intro">nsvim has no AI inside it. Your agent in the terminal sees what you look at and drives nsvim over a local socket.</p>
        <ul class="does">
          <li><strong>Reads</strong> the active file, cursor, selection, unsaved buffers and LSP errors.</li>
          <li><strong>Points</strong> at lines and leaves a note beside them.</li>
          <li><strong>Proposes</strong> changes as a diff. <kbd>y</kbd> accepts one as one undo step, <kbd>n</kbd> rejects it.</li>
          <li><strong>Marks</strong> lines changed on disk. <kbd>SPC</kbd> <kbd>a</kbd> <kbd>l</kbd> lists them.</li>
        </ul>
        <pre class="term" style="margin-top: var(--space-4)"><code><span class="c"># Claude Code: nsvim as tools over MCP</span>
<span class="p">$ </span>claude mcp add nsvim -- nsvim mcp

<span class="c"># Any agent or script, from the project folder</span>
<span class="p">$ </span>nsvim ctl state
<span class="p">$ </span>nsvim ctl reveal src/main.rs:10-14 --note "this is the bug"
<span class="p">$ </span>sed 's/foo/bar/' src/main.rs | nsvim ctl propose src/main.rs --label "rename foo"</code></pre>
        <p class="note">The socket is readable by your user only. Set <code>ipc.allow_edits = false</code> to keep agents to proposals. Setup for Codex and opencode is in <a href={`${repo}/blob/main/docs/agents.md`}>docs/agents.md</a>.</p>
      </section>

      <section class="wrap sheet" id="themes" aria-labelledby="themes-h">
        <h2 id="themes-h">Themes</h2>
        <p class="intro">{themes.length} built-in themes, {dark} dark and {light} light. The System look follows the OS. On Omarchy, it follows the desktop theme as it changes.</p>
        <div class="table-wrap">
          <table class="data stack themes-table">
            <thead>
              <tr><th scope="col">Theme</th><th scope="col">Kind</th><th scope="col">Background, accent, Insert, Visual, Command</th><th scope="col">Setting</th></tr>
            </thead>
            <tbody>
              {
                themes.map((t) => (
                  <tr>
                    <th scope="row">{t.name}</th>
                    <td class="kind">{t.light ? "Light" : "Dark"}</td>
                    <td>
                      <span class="swatches" role="img" aria-label={`${t.bg}, ${t.accent}, ${t.insert}, ${t.visual}, ${t.command}`}>
                        {[t.bg, t.accent, t.insert, t.visual, t.command].map((c) => <i style={`background:${c}`} />)}
                      </span>
                    </td>
                    <td class="set"><code>{t.light ? "theme.light" : "theme.dark"} = "{t.id}"</code></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="wrap sheet" id="install" aria-labelledby="install-h">
        <h2 id="install-h">Install</h2>
        <p class="intro">Free and open source under the MIT license. nsvim builds from source with Cargo.</p>
        <div class="steps">
          <div>
            <h3>1. Build</h3>
            <p>On Linux, the build needs the GTK 4 development packages. This installs the program <code>nsvim</code>.</p>
            <pre><code>{install}</code></pre>
          </div>
          <div>
            <h3>2. Open a project</h3>
            <p>A folder is the project. A path with <code>:line</code> opens a file at that line.</p>
            <pre><code>nsvim .
nsvim src/main.rs:42</code></pre>
          </div>
          <div>
            <h3>3. Set up</h3>
            <p>The first launch runs five steps: keys, mouse, look, terminal and ready. The terminal step makes <code>vi</code> and <code>vim</code> open nsvim, on by default. Turn it off to keep Vim and type <code>nsvim</code>. It also sets <code>$EDITOR</code> and git's editor, and shows every command before it runs.</p>
          </div>
        </div>
      </section>

      <section class="wrap sheet foot" id="origin" aria-labelledby="origin-h">
        <h2 id="origin-h">Where it comes from</h2>
        <p class="intro">
          nsvim is a fork of <a href={origin}>editor</a> by <a href="https://github.com/bjarneo">Bjarne Oeverli</a> and its contributors, under the MIT license.
          It is a separate project. Report nsvim issues on <a href={`${repo}/issues`}>GitHub</a>.
        </p>
        <div class="colophon">
          <span>nsvim · Rev {version} · MIT license</span>
          <span>Next Simple VIM · Native Shell VIM · <a href={repo}>Source on GitHub</a></span>
        </div>
      </section>
    </main>

    <script>
      // Plate 1 answers nsvim's mode keys.
      const plate = document.querySelector(".plate-1")!;
      const mock = plate.querySelector<HTMLElement>(".mock")!;
      const names: Record<string, string> = { normal: "NORMAL", insert: "INSERT", visual: "V-LINE", command: "COMMAND" };
      const said = document.getElementById("mode-said")!;
      let mode = "normal";
      const set = (m: string) => {
        if (m === mode) return;
        mode = m;
        mock.dataset.mode = m;
        plate.querySelectorAll<HTMLElement>(".modes button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === m)));
        document.getElementById("mode-name")!.textContent = names[m];
        document.getElementById("mock-pill")!.textContent = names[m];
        document.documentElement.style.setProperty("--mode", `var(--${m})`);
        said.textContent = `Plate 1 shows ${m} mode`;
      };
      plate.querySelectorAll<HTMLElement>(".modes button").forEach((b) => b.addEventListener("click", () => set(b.dataset.mode!)));
      document.addEventListener("keydown", (e) => {
        if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing) return;
        const t = e.target as HTMLElement | null;
        if (t?.closest?.("input, textarea, select, [contenteditable]")) return;
        const m = ({ i: "insert", v: "visual", ":": "command", Escape: "normal" } as Record<string, string>)[e.key];
        if (!m || (m === "normal" && mode === "normal")) return;
        e.preventDefault();
        set(m);
      });
    </script>
  </body>
</html>

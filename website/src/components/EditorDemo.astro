---
// The editor slot on the page. When `public/demo/index.html` exists (a static build of NsVim
// for the web), the slot shows it in a frame at `<base>/demo/`. Without it, the slot shows
// `Mock.astro`, a still model of the window in HTML.
//
// To ship the live editor: build it as static files and put them in `website/public/demo/`,
// with `index.html` at the top. Use relative paths inside the bundle, as the site lives under
// a base path (`/nsvim/demo/`). Nothing else on the page changes.
//
// The editor in the frame uses the classic keymap (`services::web::demo_app`): no modes.
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Mock from './Mock.astro';

interface Props { label: string }
const { label } = Astro.props;
const live = existsSync(resolve(process.cwd(), 'public/demo/index.html'));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="editor-demo" data-live={live ? 'true' : 'false'}>
  {live ? (
    <div class="demo-viewport"><iframe class="demo-frame" src={`${base}/demo/`} title={label} loading="lazy"></iframe></div>
  ) : (
    <div class="demo-screen" role="img" aria-label={label}><Mock /></div>
  )}
</div>

<script>
  // The editor needs 640 points of width (its least window size). A narrower slot, as on a
  // phone, lays the frame out 640 wide and scales it down to fit, so the whole window shows.
  const LEAST = 640;
  const viewport = document.querySelector<HTMLElement>('.demo-viewport');
  const frame = viewport?.querySelector<HTMLIFrameElement>('iframe');
  if (viewport && frame) {
    const fit = () => {
      const width = viewport.clientWidth;
      const scale = Math.min(1, width / LEAST);
      if (scale < 1) {
        const height = width * 5 / 4;
        frame.style.width = `${LEAST}px`;
        frame.style.height = `${height / scale}px`;
        frame.style.transform = `scale(${scale})`;
        viewport.style.height = `${height}px`;
      } else {
        frame.style.width = frame.style.height = frame.style.transform = viewport.style.height = '';
      }
    };
    new ResizeObserver(fit).observe(viewport);
    fit();
  }
</script>
